{
  "name": "timbre",
  "version": "1.0.0",
  "description": "Timbre — Where human and machine make music together. GarageBand simplicity for humans, god-tier programmatic power for AI.",
  "main": "main.js",
  "author": "Faye Cave <sophiacave.me@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --mac --arm64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "ai.likeone.timbre",
    "productName": "Timbre",
    "mac": {
      "category": "public.app-category.music",
      "target": ["dmg"]
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md}",
      "!**/node_modules/.cache/**"
    ]
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
