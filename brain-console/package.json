{
  "name": "like-one-brain",
  "version": "5.0.0-alpha",
  "description": "Like One — The nervous system that never sleeps.",
  "main": "main.js",
  "author": "Faye Cave <sophiacave.me@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --mac --arm64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "ai.likeone.brain",
    "productName": "Like One",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme}",
      "!**/node_modules/.cache/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "@anthropic-ai/claude-code": "^2.1.92",
    "@supabase/supabase-js": "^2.45.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.3",
    "electron-store": "^8.2.0",
    "marked": "^15.0.12",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
