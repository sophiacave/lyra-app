{
  "name": "like-one-brain",
  "version": "6.0.0",
  "description": "Like One — The nervous system that never sleeps.",
  "main": "main.js",
  "author": "Faye Cave <sophiacave.me@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --mac --arm64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "ai.likeone.brain",
    "productName": "Like One",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme}",
      "!**/node_modules/.cache/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@anthropic-ai/claude-code": "^2.1.92",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.3.3",
    "electron-store": "^8.2.0",
    "marked": "^18.0.2",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  }
}
